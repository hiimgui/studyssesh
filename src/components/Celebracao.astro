---
import type { Trilha } from '../companheiro/companheiro';

// A celebração de um Marco batido. Fica na tela até o usuário dispensar, em
// qualquer aparelho; dispensar grava que ela foi vista.
interface Props {
  trilha: Trilha;
  marco: number;
  // Para onde voltar depois de dispensar.
  voltar: string;
}

const { trilha, marco, voltar } = Astro.props;

const FRASES: Record<number, string> = {
  10: 'As primeiras 10 horas são as mais difíceis de juntar. Já foram.',
  25: 'O estudo já virou hábito.',
  50: 'Metade do caminho até as 100 horas.',
  100: 'Cem horas de estudo, uma Sessão de cada vez.',
};
const frase = FRASES[marco] ?? `São ${marco} horas acumuladas, e cada uma contou.`;
const id = `celebracao-${trilha.id}`;
---

<section class="celebracao" aria-labelledby={id}>
  <p class="selo" aria-hidden="true">{marco}h</p>
  <div class="texto">
    <h2 id={id}>Marco de {marco}h em {trilha.nome}</h2>
    <p>{frase}</p>
  </div>
  <form method="post" action="/marco">
    <input type="hidden" name="trilha" value={trilha.id} />
    <input type="hidden" name="marco" value={marco} />
    <input type="hidden" name="voltar" value={voltar} />
    <button type="submit">Seguir estudando</button>
  </form>
</section>

<style>
  .celebracao {
    position: relative;
    max-width: 36rem;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 1.5rem;
    overflow: hidden;
    border-radius: var(--raio);
    background: color-mix(in oklch, var(--destaque) 10%, var(--fundo));
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--destaque) 35%, transparent);
  }

  /* O único movimento: um traço que atravessa a borda de cima ao chegar. */
  .celebracao::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--destaque);
    animation: traco 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .selo {
    font-family: var(--fonte-titulo);
    font-size: clamp(2.5rem, 9vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--destaque);
    animation: selo 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .texto {
    display: grid;
    gap: 0.375rem;
  }

  h2 {
    font-size: 1.125rem;
    text-wrap: balance;
  }

  form {
    grid-column: 2;
  }

  @keyframes traco {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes selo {
    from {
      letter-spacing: 0.08em;
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .celebracao::before,
    .selo {
      animation: none;
    }
  }
</style>
