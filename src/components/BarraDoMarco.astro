---
import BarraDeProgresso from './BarraDeProgresso.svelte';
import type { ProgressoDaTrilha } from '../companheiro/companheiro';
import { horas } from '../lib/formato';

// A barra até o próximo Marco de horas de uma Trilha.
interface Props {
  progresso: ProgressoDaTrilha;
  // Nível do título: h2 na aba da Trilha, h3 dentro do Início.
  nivel?: 2 | 3;
}

const { progresso, nivel = 2 } = Astro.props;
const { totalSegundos, marco } = progresso;
const Titulo = nivel === 2 ? 'h2' : 'h3';
const faltaSegundos = Math.ceil((marco.proximo * 3600 - totalSegundos) / 60) * 60;
---

<div class="marco" data-nivel={nivel}>
  <div class="marco-cabeca">
    <Titulo>Marco de {marco.proximo}h</Titulo>
    <span class="placar" aria-hidden="true">
      {horas(totalSegundos)}{' '}<span class="suave">/ {marco.proximo}h</span>
    </span>
  </div>
  <BarraDeProgresso
    valor={totalSegundos}
    maximo={marco.proximo * 3600}
    rotulo={`Horas até o Marco de ${marco.proximo}h`}
    texto={`${horas(totalSegundos)} de ${marco.proximo}h`}
  />
  <p class="suave">
    {totalSegundos === 0
      ? 'A primeira Sessão já começa a encher a barra.'
      : `Faltam ${horas(faltaSegundos)}.`}
    {marco.anterior > 0 && ` O Marco de ${marco.anterior}h já ficou para trás.`}
  </p>
</div>

<style>
  .marco {
    display: grid;
    gap: 0.625rem;
  }

  .marco-cabeca {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  h2,
  h3 {
    margin: 0;
  }

  [data-nivel='3'] h3 {
    font-family: var(--fonte-corpo);
    font-size: inherit;
    font-weight: 500;
  }

  .placar {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
