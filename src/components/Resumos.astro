---
import { type Objetivo, type Resumo, type Trilha } from '../companheiro/companheiro';
import { dataDe } from '../companheiro/fuso';
import { quandoSaiu, semanaPorExtenso } from '../lib/formato';
import { linkGerarAgora, resumoAtrasado } from '../lib/resumo';
import ResumoCompleto from './ResumoCompleto.astro';

// O Resumo mais recente da Trilha, aberto; os anteriores ficam no histórico
// (/resumos). Na consulta de uma Trilha arquivada, só leitura e sem "gerar agora".
interface Props {
  trilha: Trilha;
  ultimo: Resumo | null;
  objetivos: Objetivo[];
  consultando: boolean;
}

const { trilha, ultimo, objetivos, consultando } = Astro.props;
const agora = new Date();
// Sem nenhum Objetivo não há Resumo: toda Recomendação precisa de um, e a
// routine pula a Trilha. Então também não há atraso.
const semObjetivo = objetivos.length === 0;
const atrasado = !consultando && !semObjetivo && resumoAtrasado(ultimo, trilha.criadaEm, agora);
---

<section class="resumos" aria-labelledby="titulo-resumos">
  <div class="cabeca">
    <div class="titulo-linha">
      <h2 id="titulo-resumos">Resumos</h2>
      {ultimo && <a class="historico" href={`/resumos?trilha=${trilha.id}`}>Ver histórico</a>}
    </div>
    <p class="suave">
      {
        ultimo
          ? `O último saiu ${quandoSaiu(ultimo.geradoEm)}.`
          : consultando
            ? 'Esta Trilha não teve Resumos.'
            : semObjetivo
              ? 'Os Resumos começam quando a Trilha tiver um Objetivo.'
              : 'O primeiro sai numa segunda, às 7:07, cobrindo a semana anterior.'
      }
    </p>
    {
      atrasado && (
        <p class="atraso" role="status">
          O Resumo da semana passada não chegou. Dá para pedir agora.
        </p>
      )
    }
    {
      !consultando && !semObjetivo && (
        <a
          class="gerar botao-secundario"
          href={linkGerarAgora(trilha, dataDe(agora))}
          target="_blank"
          rel="noopener noreferrer"
        >
          Gerar agora no Claude
        </a>
      )
    }
  </div>

  {
    ultimo && (
      <article class="resumo" aria-labelledby="semana-do-ultimo">
        <h3 class="semana" id="semana-do-ultimo">
          {semanaPorExtenso(ultimo.semana)}
        </h3>
        <ResumoCompleto
          resumo={ultimo}
          objetivos={objetivos}
          consultando={consultando}
          voltar={`/?trilha=${trilha.id}`}
        />
      </article>
    )
  }
</section>

<style>
  .resumos {
    display: grid;
    gap: 1.25rem;
    max-width: 36rem;
  }

  .cabeca {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .titulo-linha {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    justify-self: stretch;
  }

  .historico {
    font-size: 0.8125rem;
    color: var(--texto-suave);
    text-decoration-color: var(--linha);
    text-underline-offset: 3px;
  }

  .historico:hover {
    color: var(--texto);
    text-decoration-color: currentColor;
  }

  .atraso {
    color: var(--texto);
  }

  .gerar {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.5rem 0.875rem;
    border-radius: var(--raio);
    text-decoration: none;
  }

  .resumo {
    border-top: 1px solid var(--linha);
    border-bottom: 1px solid var(--linha);
  }

  .semana {
    margin: 0;
    padding-block: 0.875rem;
    font-size: inherit;
    font-weight: 500;
  }
</style>
