---
import Base from '../layouts/Base.astro';
import ResumoCompleto from '../components/ResumoCompleto.astro';
import {
  criarCompanheiro,
  SITUACOES,
  type SituacaoDaRecomendacao,
} from '../companheiro/companheiro';
import {
  nomeDoObjetivo,
  quandoSaiu,
  quantasNaSituacao,
  ROTULO_DA_SITUACAO,
  semanaPorExtenso,
} from '../lib/formato';

// Histórico de Resumos de uma Trilha, com filtros por Objetivo e por situação
// das Recomendações. Trilha alheia ou inexistente: 404.
const companheiro = criarCompanheiro({ supabase: Astro.locals.supabase });
const busca = Astro.url.searchParams;
const trilhaId = busca.get('trilha') ?? '';
const objetivoId = busca.get('objetivo') || undefined;
const pedida = busca.get('situacao');
const situacao = SITUACOES.find((s) => s === pedida);

const historico = /^[0-9a-f-]{36}$/i.test(trilhaId)
  ? await companheiro.historicoDeResumos('usuario', { trilhaId, objetivoId, situacao })
  : null;
if (!historico) return new Response('Trilha não encontrada.', { status: 404 });

const { trilha, resumos } = historico;
const objetivos = await companheiro.listarObjetivos('usuario', { trilhaId });
const consultando = trilha.arquivadaEm !== null;
const filtrando = !!objetivoId || !!situacao;
const semFiltro = `/resumos?trilha=${trilha.id}`;
// A resposta a uma Recomendação volta para esta mesma lista, filtros incluídos.
const aqui = Astro.url.pathname + Astro.url.search;

const objetivoEscolhido = objetivos.find((o) => o.id === objetivoId);
const OPCOES_DE_SITUACAO: Record<SituacaoDaRecomendacao, string> = {
  aberta: 'Em aberto',
  aceita: 'Aceitas',
  recusada: 'Recusadas',
};
const vazio = [
  'Nenhum Resumo com Recomendações',
  situacao && ROTULO_DA_SITUACAO[situacao],
  objetivoEscolhido && `para “${nomeDoObjetivo(objetivoEscolhido)}”`,
]
  .filter(Boolean)
  .join(' ');
---

<Base titulo={`Resumos · ${trilha.nome}`}>
  <header>
    <a class="marca" href="/">Aibou</a>
    <a class="voltar" href={`/?trilha=${trilha.id}`}>Voltar para {trilha.nome}</a>
  </header>

  <main>
    <div class="cabeca">
      <h1>Resumos</h1>
      <p class="suave">
        {consultando ? `${trilha.nome}. Trilha arquivada, só para consulta.` : `${trilha.nome}.`}
      </p>
    </div>

    <form class="filtros" method="get" action="/resumos" aria-label="Filtrar Resumos">
      <input type="hidden" name="trilha" value={trilha.id} />
      <div class="campo">
        <label for="objetivo">Objetivo</label>
        <select id="objetivo" name="objetivo">
          <option value="">Todos</option>
          {
            objetivos.map((o) => (
              <option value={o.id} selected={o.id === objetivoId}>
                {nomeDoObjetivo(o)}
              </option>
            ))
          }
        </select>
      </div>
      <div class="campo campo-situacao">
        <label for="situacao">Recomendações</label>
        <select id="situacao" name="situacao">
          <option value="">Todas</option>
          {
            SITUACOES.map((s) => (
              <option value={s} selected={s === situacao}>
                {OPCOES_DE_SITUACAO[s]}
              </option>
            ))
          }
        </select>
      </div>
      <div class="acoes">
        <button class="botao-secundario" type="submit">Filtrar</button>
        {filtrando && <a class="limpar" href={semFiltro}>Limpar</a>}
      </div>
    </form>

    {
      resumos.length === 0 ? (
        <p class="vazio" role="status">
          {filtrando ? (
            <>
              {vazio}. <a href={semFiltro}>Ver todos os Resumos</a>
            </>
          ) : (
            consultando ? 'Esta Trilha não teve Resumos.' : 'Esta Trilha ainda não tem Resumos.'
          )}
        </p>
      ) : (
        <ol class="linha-do-tempo" aria-label="Resumos, do mais novo ao mais antigo">
          {resumos.map((r) => (
            <li>
              <details class="resumo" id={`resumo-${r.id}`}>
                <summary>
                  <span class="semana">{semanaPorExtenso(r.semana)}</span>
                  <span class="suave quando">{quandoSaiu(r.geradoEm)}</span>
                  <span class="contagem">
                    {SITUACOES.filter((s) => r.contagem[s] > 0).map((s) => (
                      <span data-situacao={s}>{quantasNaSituacao(r.contagem[s], s)}</span>
                    ))}
                  </span>
                </summary>
                <ResumoCompleto
                  resumo={r}
                  objetivos={objetivos}
                  consultando={consultando}
                  voltar={aqui}
                />
              </details>
            </li>
          ))}
        </ol>
      )
    }
  </main>
</Base>

<script>
  // Ao voltar de aceitar ou recusar, o endereço aponta a Recomendação: o
  // Resumo dela abre e a página rola até lá.
  const alvo = location.hash && document.getElementById(location.hash.slice(1));
  const resumo = alvo instanceof HTMLElement ? alvo.closest('details.resumo') : null;
  if (resumo instanceof HTMLDetailsElement && alvo instanceof HTMLElement) {
    resumo.open = true;
    alvo.scrollIntoView({ block: 'center' });
  }
</script>

<style>
  header,
  main {
    width: min(100% - 2 * var(--espaco), 60rem);
    margin-inline: auto;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--linha);
  }

  .marca {
    font-family: var(--fonte-titulo);
    font-size: 1.25rem;
    text-decoration: none;
  }

  .voltar {
    color: var(--texto-suave);
    text-underline-offset: 3px;
    text-decoration-color: var(--linha);
    overflow-wrap: anywhere;
  }

  .voltar:hover {
    color: var(--texto);
    text-decoration-color: currentColor;
  }

  main {
    display: grid;
    gap: 2rem;
    padding-block: clamp(2rem, 8vw, 4rem);
  }

  main > * {
    max-width: 36rem;
  }

  .cabeca {
    display: grid;
    gap: 0.5rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 0.5rem;
  }

  .campo {
    display: grid;
    flex: 1 1 14rem;
    gap: 0.375rem;
    min-width: 0;
  }

  .campo-situacao {
    flex: 1 1 10rem;
  }

  .campo label {
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }

  .campo select {
    text-overflow: ellipsis;
  }

  .acoes {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Mesma altura dos campos ao lado. */
  .acoes button {
    padding-block: 0.6875rem;
  }

  .limpar,
  .vazio a {
    color: var(--texto-suave);
    text-underline-offset: 3px;
    text-decoration-color: var(--linha);
  }

  .limpar:hover,
  .vazio a:hover {
    color: var(--texto);
    text-decoration-color: currentColor;
  }

  .vazio {
    padding-block: 1.5rem;
    border-block: 1px solid var(--linha);
    color: var(--texto-suave);
    text-wrap: pretty;
  }

  .linha-do-tempo {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .linha-do-tempo > li {
    border-top: 1px solid var(--linha);
  }

  .linha-do-tempo > li:last-child {
    border-bottom: 1px solid var(--linha);
  }

  .resumo > summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.125rem 1rem;
    padding-block: 0.875rem;
    cursor: pointer;
    list-style: none;
  }

  .resumo > summary::-webkit-details-marker {
    display: none;
  }

  .semana {
    flex-basis: 100%;
    font-weight: 500;
  }

  .resumo:not([open]) .semana {
    text-decoration: underline;
    text-decoration-color: var(--linha);
    text-underline-offset: 4px;
  }

  .resumo > summary:hover .semana {
    text-decoration-color: currentColor;
  }

  .quando {
    font-size: 0.8125rem;
  }

  .contagem {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--texto-suave);
  }

  /* Em aberto é o que ainda pede resposta. */
  .contagem [data-situacao='aberta'] {
    color: var(--destaque);
  }
</style>
