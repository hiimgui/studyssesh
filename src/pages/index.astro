---
import Base from '../layouts/Base.astro';
import Cronometro from '../components/Cronometro.svelte';
import BarraDeProgresso from '../components/BarraDeProgresso.svelte';
import BarraDoMarco from '../components/BarraDoMarco.astro';
import Celebracao from '../components/Celebracao.astro';
import Inicio from '../components/Inicio.astro';
import Resumos from '../components/Resumos.astro';
import Biblioteca from '../components/Biblioteca.astro';
import {
  criarCompanheiro,
  EntradaInvalida,
  INATIVIDADE_MS,
  objetivoParaCelebrar,
  semObjetivoEmAndamento,
  type Objetivo,
  type Periodo,
  type Sessao,
} from '../companheiro/companheiro';
import { dataDe, FUSO, semanaDe } from '../companheiro/fuso';
import {
  descreverPeriodo,
  diaMes,
  faltam,
  horas,
  nomeDoMes,
  nomeDoObjetivo,
  progresso,
} from '../lib/formato';

const companheiro = criarCompanheiro({ supabase: Astro.locals.supabase });

// A página atende os formulários de Trilha e de Objetivo: criar Trilha,
// definir, concluir e, depois da celebração, arquivar a Trilha.
let erro: string | null = null;
let erroObjetivo: string | null = null;
let enviado: FormData | null = null;
if (Astro.request.method === 'POST') {
  enviado = await Astro.request.formData();
  const campo = (nome: string) => String(enviado?.get(nome) ?? '');
  const voltar = (extra = '') =>
    Astro.redirect(`/?trilha=${encodeURIComponent(campo('trilha'))}${extra}`, 303);
  try {
    if (campo('acao') === 'definir-objetivo') {
      const trilhaId = campo('trilha');
      if (campo('tipo') === 'abstrato') {
        await companheiro.criarObjetivoAbstrato('usuario', {
          trilhaId,
          descricao: campo('descricao'),
        });
      } else {
        const escolha = campo('periodo');
        const periodo: Periodo =
          escolha === 'semana' || escolha === 'mes'
            ? escolha
            : { de: campo('de'), ate: campo('ate') };
        await companheiro.criarObjetivoMensuravel('usuario', {
          trilhaId,
          metaHoras: Number(campo('horas').replace(',', '.')),
          periodo,
        });
      }
      return voltar();
    }
    if (campo('acao') === 'concluir-objetivo') {
      await companheiro.concluirObjetivo('usuario', { objetivoId: campo('objetivo') });
      return voltar('&celebrar=1');
    }
    if (campo('acao') === 'arquivar-trilha') {
      await companheiro.arquivarTrilha('usuario', { trilhaId: campo('trilha') });
      return Astro.redirect(`/?arquivada=${encodeURIComponent(campo('trilha'))}`, 303);
    }
    const trilha = await companheiro.criarTrilha('usuario', { nome: campo('nome') });
    return Astro.redirect(`/?trilha=${trilha.id}`, 303);
  } catch (e) {
    if (!(e instanceof EntradaInvalida)) throw e;
    if (campo('acao') === '' || campo('acao') === 'criar-trilha') erro = e.message;
    else erroObjetivo = e.message;
  }
}

const trilhas = await companheiro.listarTrilhas('usuario');
const arquivadas = await companheiro.listarTrilhasArquivadas('usuario');
const idEscolhido =
  Astro.url.searchParams.get('trilha') ?? (erroObjetivo ? String(enviado?.get('trilha')) : null);
// Uma Trilha arquivada abre só para consulta, fora das abas.
const consultando = arquivadas.find((t) => t.id === idEscolhido);
const criando = !consultando && (idEscolhido === 'nova' || trilhas.length === 0);
// Sem Trilha escolhida, a página é o Início.
const noInicio = !consultando && !criando && !idEscolhido;
const atual =
  consultando ??
  (criando || noInicio ? null : (trilhas.find((t) => t.id === idEscolhido) ?? trilhas[0]));
const recemArquivada = arquivadas.find((t) => t.id === Astro.url.searchParams.get('arquivada'));
const inicio = noInicio ? await companheiro.inicio('usuario') : null;
const progressoAqui = atual
  ? await companheiro.progressoDaTrilha('usuario', { trilhaId: atual.id })
  : null;
const timer = await companheiro.timerLigado('usuario');
const timerAqui = timer && atual && timer.trilhaId === atual.id ? timer : null;
const timerEm = timer && !timerAqui ? trilhas.find((t) => t.id === timer.trilhaId) : undefined;
// O rascunho da nota fica neste aparelho, preso ao timer ligado agora: sobrevive
// às recargas de pausar, retomar e Inatividade, e some quando o timer acaba.
const chaveDoRascunho = timer ? `aibou:nota:${timer.iniciadoEm.toISOString()}` : '';
// Na consulta de uma Trilha arquivada, todas as Sessões; nas abas, as 10 mais recentes.
const sessoes = atual
  ? await companheiro.listarSessoes('usuario', {
      trilhaId: atual.id,
      limite: consultando ? undefined : 10,
    })
  : [];
const objetivos = atual ? await companheiro.listarObjetivos('usuario', { trilhaId: atual.id }) : [];
// Na Trilha, só o último Resumo; os anteriores ficam no histórico.
const resumos = atual
  ? await companheiro.listarResumos('usuario', { trilhaId: atual.id, limite: 1 })
  : [];
const biblioteca = atual
  ? await companheiro.listarBiblioteca('usuario', { trilhaId: atual.id })
  : [];
const emAndamento = objetivos.filter((o) => o.situacao === 'em-andamento');
// O Objetivo a que um projeto aceito serve.
const servido = (o: Objetivo) =>
  o.tipo === 'abstrato' && o.projetoDe ? objetivos.find((p) => p.id === o.projetoDe) : undefined;
const pedirObjetivo = !consultando && semObjetivoEmAndamento(objetivos);
const celebrado = consultando ? null : objetivoParaCelebrar(objetivos);
// A animação da celebração toca na hora da conclusão; depois, fica parada.
const celebrarAgora = Astro.url.searchParams.has('celebrar');
// Sem Objetivo em andamento, o último que acabou dá contexto ao pedido.
const ultimoQueAcabou = pedirObjetivo ? (celebrado ?? objetivos.at(-1)) : undefined;
// Na consulta de uma Trilha arquivada, todo o histórico de Objetivos.
const objetivosVisiveis = consultando
  ? objetivos
  : [...emAndamento, ...(ultimoQueAcabou ? [ultimoQueAcabou] : [])];

const agora = new Date();
const pausaAutomatica = timer && new Date(timer.ultimaInteracaoEm.getTime() + INATIVIDADE_MS);
const erroFim = Astro.url.searchParams.get('erro') === 'fim';
// Com o timer contando, a página avisa o servidor quando o usuário mexe nela.
const msAteInatividade =
  timer && !timer.pausado ? Math.max(0, pausaAutomatica!.getTime() - agora.getTime()) : null;

const hoje = dataDe(agora);
const semana = semanaDe(hoje);
const valorEnviado = (nome: string, padrao = '') =>
  erroObjetivo ? String(enviado?.get(nome) ?? padrao) : padrao;
const periodoEnviado = valorEnviado('periodo', 'mes');
const tipoEnviado = valorEnviado('tipo', 'mensuravel');

const dataLonga = (d: Date) => d.toLocaleDateString('pt-BR', { dateStyle: 'long', timeZone: FUSO });
const dia = (d: Date) =>
  d.toLocaleDateString('pt-BR', { weekday: 'short', day: 'numeric', month: 'short', timeZone: FUSO });
const hora = (d: Date) => d.toLocaleTimeString('pt-BR', { timeStyle: 'short', timeZone: FUSO });
const duracao = ({ duracaoSegundos }: Sessao) => {
  const minutos = Math.floor(duracaoSegundos / 60);
  if (minutos < 1) return 'menos de 1 min';
  if (minutos < 60) return `${minutos} min`;
  return `${Math.floor(minutos / 60)}h ${String(minutos % 60).padStart(2, '0')}min`;
};
---

<Base titulo={atual?.nome ?? (noInicio ? 'Início' : undefined)}>
  <header>
    <span class="marca">Aibou</span>
    <form method="post" action="/sair">
      <button class="botao-discreto" type="submit">Sair</button>
    </form>
  </header>

  <nav aria-label="Trilhas">
    <ul>
      {
        trilhas.length > 0 && (
          <li>
            <a href="/" aria-current={noInicio ? 'page' : undefined}>
              Início
            </a>
          </li>
        )
      }
      {
        trilhas.map((t) => (
          <li>
            <a href={`/?trilha=${t.id}`} aria-current={t.id === atual?.id ? 'page' : undefined}>
              {t.nome}
              {t.id === timer?.trilhaId && (
                <span class="contando" data-pausado={timer.pausado || undefined}>
                  <span class="visualmente-oculto">
                    {timer.pausado ? '(timer pausado)' : '(timer ligado)'}
                  </span>
                </span>
              )}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/?trilha=nova" aria-current={criando ? 'page' : undefined}>
          <span aria-hidden="true">+</span> Nova Trilha
        </a>
      </li>
      {arquivadas.length > 0 && (
        <li class="aba-arquivadas">
          <a href="/arquivadas" aria-current={consultando ? 'page' : undefined}>
            Arquivadas
          </a>
        </li>
      )}
    </ul>
  </nav>

  <main>
    {recemArquivada && (
      <p class="aviso" role="status">
        {recemArquivada.nome} foi arquivada. Ela continua em{' '}
        <a href="/arquivadas">Arquivadas</a>, com todo o histórico.
      </p>
    )}
    {
      atual ? (
        <div class="trilha">
          <section class="cabeca">
            <h1>{atual.nome}</h1>
            <p class="suave">
              Trilha criada em {dataLonga(atual.criadaEm)}
              {atual.arquivadaEm ? `, arquivada em ${dataLonga(atual.arquivadaEm)}.` : '.'}
            </p>
          </section>

          {!consultando && progressoAqui!.marcoParaCelebrar !== null && (
            <Celebracao
              trilha={atual}
              marco={progressoAqui!.marcoParaCelebrar}
              voltar={`/?trilha=${atual.id}`}
            />
          )}

          <section class="marco" aria-label="Marco">
            <BarraDoMarco progresso={progressoAqui!} />
          </section>

          <section class="objetivos" aria-label="Objetivos">
            {objetivosVisiveis.map((o) =>
              o.tipo === 'mensuravel' ? (
                <article
                  class="objetivo"
                  data-situacao={o.situacao}
                  data-celebrando={(celebrarAgora && o.id === celebrado?.id) || undefined}
                >
                  <div class="objetivo-cabeca">
                    <h2>
                      {horas(o.metaHoras * 3600)} de estudo {descreverPeriodo(o.periodo)}
                    </h2>
                    <span class="placar" aria-hidden="true">
                      {horas(o.estudadoSegundos)}{' '}
                      <span class="suave">/ {horas(o.metaHoras * 3600)}</span>
                    </span>
                  </div>
                  <BarraDeProgresso
                    valor={o.estudadoSegundos}
                    maximo={o.metaHoras * 3600}
                    rotulo="Progresso do Objetivo"
                    texto={progresso(o)}
                    apagada={o.situacao === 'encerrado'}
                  />
                  <p class="suave">
                    {o.situacao === 'em-andamento' &&
                      (o.periodo.de > hoje
                        ? `Começa em ${diaMes(o.periodo.de)}.`
                        : `Faltam ${faltam(o)}, até ${diaMes(o.periodo.ate)}.`)}
                    {o.situacao === 'concluido' &&
                      `Meta batida em ${dataLonga(o.concluidoEm!)}.`}
                    {o.situacao === 'encerrado' &&
                      `O período acabou em ${diaMes(o.periodo.ate)}, com ${progresso(o)}.`}
                  </p>
                </article>
              ) : (
                <article
                  class="objetivo"
                  data-situacao={o.situacao}
                  data-celebrando={(celebrarAgora && o.id === celebrado?.id) || undefined}
                >
                  <div class="objetivo-cabeca">
                    <h2>{o.descricao}</h2>
                    <span class="placar" aria-hidden="true">
                      {o.situacao === 'concluido' ? (
                        <span class="suave">concluído</span>
                      ) : (
                        <>
                          {o.itens.concluidos} <span class="suave">/ {o.itens.total} itens</span>
                        </>
                      )}
                    </span>
                  </div>
                  {servido(o) && (
                    <p class="suave projeto-de">Projeto para: {nomeDoObjetivo(servido(o)!)}</p>
                  )}
                  {/* Concluído é chegar lá: a barra enche, mesmo sem itens ligados. */}
                  <BarraDeProgresso
                    valor={o.situacao === 'concluido' ? 1 : o.itens.concluidos}
                    maximo={o.situacao === 'concluido' ? 1 : o.itens.total}
                    rotulo="Progresso do Objetivo"
                    texto={
                      o.situacao === 'concluido'
                        ? 'Concluído'
                        : `${o.itens.concluidos} de ${o.itens.total} itens concluídos`
                    }
                  />
                  {o.situacao === 'concluido' ? (
                    <p class="suave">Concluído em {dataLonga(o.concluidoEm!)}.</p>
                  ) : (
                    <>
                      <p class="suave">
                        {o.itens.total === 0
                          ? 'Nenhum item ligado ainda. Projetos, Decks e materiais aceitos num Resumo contam aqui.'
                          : `${o.itens.concluidos} de ${o.itens.total} itens concluídos.`}
                      </p>
                      {!consultando && (
                        <details class="concluir">
                          <summary>Concluir Objetivo</summary>
                          <form method="post" class="concluir-confirma">
                            <input type="hidden" name="acao" value="concluir-objetivo" />
                            <input type="hidden" name="trilha" value={atual.id} />
                            <input type="hidden" name="objetivo" value={o.id} />
                            <p>Você chegou lá? Concluir não tem volta.</p>
                            <button type="submit">Sim, concluir</button>
                          </form>
                        </details>
                      )}
                    </>
                  )}
                </article>
              ),
            )}

            {consultando && objetivos.length === 0 && (
              <p class="suave">Esta Trilha não teve Objetivos.</p>
            )}

            {celebrado && (
              <div class="celebracao" data-agora={celebrarAgora || undefined} role="status">
                <h2>Você chegou lá.</h2>
                <p>
                  {celebrado.tipo === 'abstrato'
                    ? `“${celebrado.descricao}” está concluído.`
                    : `A meta de ${horas(celebrado.metaHoras * 3600)} foi batida.`}{' '}
                  E agora: um novo Objetivo ou guardar a Trilha?
                </p>
                <div class="escolhas">
                  <a class="escolha" href="#titulo-pedido">
                    <span class="escolha-titulo">Definir o próximo Objetivo</span>
                    <span class="escolha-explica">A Trilha continua nas abas.</span>
                  </a>
                  <form method="post" class="escolha-form">
                    <input type="hidden" name="acao" value="arquivar-trilha" />
                    <input type="hidden" name="trilha" value={atual.id} />
                    <button class="escolha" type="submit">
                      <span class="escolha-titulo">Arquivar a Trilha</span>
                      <span class="escolha-explica">Sai das abas, com o histórico guardado.</span>
                    </button>
                  </form>
                </div>
              </div>
            )}

            {pedirObjetivo && (
              <div class="pedido">
                <h2 id="titulo-pedido">
                  {objetivos.length === 0 ? 'Qual é o Objetivo desta Trilha?' : 'Qual é o próximo Objetivo?'}
                </h2>
                <p class="suave">
                  Uma meta de horas num período, ou algo que você quer alcançar.
                </p>
                <form method="post" class="definir" aria-labelledby="titulo-pedido">
                  <input type="hidden" name="acao" value="definir-objetivo" />
                  <input type="hidden" name="trilha" value={atual.id} />
                  <fieldset class="tipo">
                    <legend class="visualmente-oculto">Tipo de Objetivo</legend>
                    <label>
                      <input
                        type="radio"
                        name="tipo"
                        value="mensuravel"
                        checked={tipoEnviado !== 'abstrato'}
                      />
                      Meta de horas
                    </label>
                    <label>
                      <input
                        type="radio"
                        name="tipo"
                        value="abstrato"
                        checked={tipoEnviado === 'abstrato'}
                      />
                      Algo a alcançar
                    </label>
                  </fieldset>
                  <div class="campo campo-descricao so-abstrato">
                    <label for="descricao">O que você quer alcançar?</label>
                    <input
                      id="descricao"
                      name="descricao"
                      type="text"
                      maxlength="120"
                      placeholder="Ex.: conseguir a certificação"
                      value={valorEnviado('descricao')}
                    />
                  </div>
                  <div class="campo campo-horas so-mensuravel">
                    <label for="horas">Horas</label>
                    <input
                      id="horas"
                      name="horas"
                      type="number"
                      inputmode="decimal"
                      min="0.5"
                      step="0.5"
                      placeholder="10"
                      value={valorEnviado('horas')}
                    />
                  </div>
                  <div class="campo campo-periodo so-mensuravel">
                    <label for="periodo">Período</label>
                    <select id="periodo" name="periodo">
                      <option value="mes" selected={periodoEnviado === 'mes'}>
                        neste mês ({nomeDoMes(hoje)})
                      </option>
                      <option value="semana" selected={periodoEnviado === 'semana'}>
                        nesta semana ({descreverPeriodo(semana).replace(/^de /, '')})
                      </option>
                      <option value="datas" selected={periodoEnviado === 'datas'}>
                        em outras datas
                      </option>
                    </select>
                  </div>
                  <fieldset class="datas so-mensuravel">
                    <legend class="visualmente-oculto">Datas do período</legend>
                    <div class="campo">
                      <label for="de">De</label>
                      <input id="de" name="de" type="date" value={valorEnviado('de', hoje)} />
                    </div>
                    <div class="campo">
                      <label for="ate">Até</label>
                      <input id="ate" name="ate" type="date" min={hoje} value={valorEnviado('ate')} />
                    </div>
                  </fieldset>
                  <button type="submit">Definir Objetivo</button>
                </form>
                {erroObjetivo && <p class="erro" role="alert">{erroObjetivo}</p>}
              </div>
            )}
          </section>

          {!consultando && (
            <section class="timer" aria-label="Timer">
              {timerAqui?.pausadoPorInatividade ? (
                <>
                  <Cronometro
                    client:load
                    estudadoMs={timerAqui.estudadoMs}
                    pausado
                    trilha={atual.nome}
                  />
                  <p class="suave" role="status">
                    Sem interação desde {hora(timerAqui.ultimaInteracaoEm)}, o timer pausou sozinho
                    às {hora(pausaAutomatica!)}.
                  </p>
                  <div class="volta">
                    <h2 id="titulo-volta">Até quando você estudou?</h2>
                    <form method="post" action="/timer" class="opcoes" aria-labelledby="titulo-volta">
                      <input type="hidden" name="trilha" value={atual.id} />
                      <input type="hidden" name="acao" value="fim-do-estudo" />
                      {[
                        { ate: timerAqui.ultimaInteracaoEm, explica: 'última vez que mexi no app' },
                        { ate: pausaAutomatica!, explica: 'quando o timer pausou' },
                        { ate: agora, explica: 'estudei até agora' },
                      ].map(({ ate, explica }) => (
                        <button class="opcao" type="submit" name="ate" value={ate.toISOString()}>
                          <span class="opcao-hora">{hora(ate)}</span>
                          <span class="opcao-explica">{explica}</span>
                        </button>
                      ))}
                    </form>
                    <form method="post" action="/timer" class="outro-horario">
                      <input type="hidden" name="trilha" value={atual.id} />
                      <input type="hidden" name="acao" value="fim-do-estudo" />
                      <label for="hora">Outro horário</label>
                      <div class="linha">
                        <input id="hora" name="hora" type="time" required />
                        <button class="botao-secundario" type="submit">Confirmar</button>
                      </div>
                    </form>
                    {erroFim && (
                      <p class="erro" role="alert">
                        Escolha um horário entre {hora(timerAqui.ultimaInteracaoEm)} e agora.
                      </p>
                    )}
                  </div>
                </>
              ) : timerAqui ? (
                <>
                  <Cronometro
                    client:load
                    estudadoMs={timerAqui.estudadoMs}
                    pausado={timerAqui.pausado}
                    trilha={atual.nome}
                  />
                  <p class="suave" role="status">
                    {timerAqui.pausado
                      ? 'Pausado. A pausa não conta como estudo.'
                      : `Contando desde ${hora(timerAqui.iniciadoEm)}.`}
                  </p>
                  <form method="post" action="/timer" class="encerrar">
                    <input type="hidden" name="trilha" value={atual.id} />
                    <label for="nota">O que você estudou? (opcional)</label>
                    <input
                      id="nota"
                      name="nota"
                      type="text"
                      maxlength="500"
                      placeholder="Ex.: kanji da lição 4"
                    />
                    <div class="acoes">
                      <button type="submit" name="acao" value="encerrar">
                        Encerrar Sessão
                      </button>
                      <button
                        class="botao-secundario"
                        type="submit"
                        name="acao"
                        value={timerAqui.pausado ? 'retomar' : 'pausar'}
                      >
                        {timerAqui.pausado ? 'Retomar' : 'Pausar'}
                      </button>
                    </div>
                  </form>
                </>
              ) : (
                <>
                  <span class="cronometro-parado" aria-hidden="true">00:00:00</span>
                  {timerEm ? (
                    <p class="suave" role="status">
                      O timer está {timer?.pausado ? 'pausado' : 'ligado'} em{' '}
                      <a href={`/?trilha=${timerEm.id}`}>{timerEm.nome}</a>. Só um conta por vez.
                    </p>
                  ) : (
                    <p class="suave">Ligue o timer quando começar a estudar.</p>
                  )}
                  <form method="post" action="/timer" class="acoes">
                    <input type="hidden" name="trilha" value={atual.id} />
                    <button type="submit" name="acao" value="iniciar" disabled={!!timerEm}>
                      Iniciar timer
                    </button>
                  </form>
                </>
              )}
            </section>
          )}

          <Resumos
            trilha={atual}
            ultimo={resumos[0] ?? null}
            objetivos={objetivos}
            consultando={!!consultando}
          />

          {/* Antes do primeiro Resumo não há o que aceitar: a seção ainda não aparece. */}
          {(resumos.length > 0 || biblioteca.length > 0) && (
            <Biblioteca
              trilha={atual}
              itens={biblioteca}
              objetivos={objetivos}
              consultando={!!consultando}
            />
          )}

          <section class="sessoes" aria-labelledby="titulo-sessoes">
            <h2 id="titulo-sessoes">{consultando ? 'Sessões' : 'Sessões recentes'}</h2>
            {sessoes.length === 0 ? (
              <p class="suave">
                {consultando
                  ? 'Esta Trilha não teve Sessões.'
                  : 'Nenhuma Sessão ainda. A primeira sai do timer.'}
              </p>
            ) : (
              <ol>
                {sessoes.map((s) => (
                  <li>
                    <span class="quando">
                      <span>{dia(s.inicio)},</span> <span>{hora(s.inicio)}–{hora(s.fim)}</span>
                    </span>
                    <span class="duracao">{duracao(s)}</span>
                    {s.nota && <span class="nota">{s.nota}</span>}
                  </li>
                ))}
              </ol>
            )}
          </section>
        </div>
      ) : inicio ? (
        <Inicio inicio={inicio} timer={timer} />
      ) : (
        <section>
          <h1>{trilhas.length === 0 ? 'O que você vai estudar?' : 'Nova Trilha'}</h1>
          <p class="suave">Cada assunto vira uma Trilha, com aba própria.</p>
          <form method="post" class="nova-trilha">
            <label class="visualmente-oculto" for="nome">Nome da Trilha</label>
            <input
              id="nome"
              name="nome"
              type="text"
              placeholder="Ex.: Claude Certified Architect"
              maxlength="80"
              required
              autofocus
            />
            <button type="submit">Criar Trilha</button>
          </form>
          {erro && <p class="erro" role="alert">{erro}</p>}
        </section>
      )
    }
  </main>
  {msAteInatividade !== null && <div id="presenca" data-ms-ate-inatividade={msAteInatividade} hidden />}
  <div id="rascunho" data-chave={chaveDoRascunho} hidden></div>
</Base>

<script>
  // Com abas demais para a largura, a aba atual rola para a vista (só a
  // faixa das abas: a página fica onde está, inclusive num #âncora).
  const abas = document.querySelector('nav');
  const atual = abas?.querySelector('[aria-current="page"]');
  if (abas && atual) {
    const sobra = atual.getBoundingClientRect().right - abas.getBoundingClientRect().right;
    if (sobra > 0) abas.scrollLeft += sobra + 40;
  }
</script>

<script>
  // Rascunho da nota da Sessão: guardado a cada tecla e devolvido ao campo
  // depois de qualquer recarga. Rascunhos de timers que já acabaram são
  // apagados. Sem localStorage (aba anônima, bloqueio), o campo só não lembra.
  const chave = document.getElementById('rascunho')?.dataset.chave ?? '';
  const nota = document.querySelector<HTMLInputElement>('#nota');
  try {
    for (const k of Object.keys(localStorage)) {
      if (k.startsWith('aibou:nota:') && k !== chave) localStorage.removeItem(k);
    }
    if (chave && nota) {
      nota.value ||= localStorage.getItem(chave) ?? '';
      nota.addEventListener('input', () => {
        try {
          if (nota.value) localStorage.setItem(chave, nota.value);
          else localStorage.removeItem(chave);
        } catch {
          // Armazenamento cheio ou bloqueado: segue sem rascunho.
        }
      });
    }
  } catch {
    // localStorage indisponível.
  }
</script>

<script>
  // Inatividade: enquanto o timer conta, cada interação com a página avisa o
  // servidor (no máximo uma vez por minuto). Se a hora sem interação se
  // completar, ou se a volta encontrar o timer pausado, a página recarrega e
  // mostra a pergunta "até quando você estudou?".
  const presenca = document.getElementById('presenca');
  if (presenca) {
    const UMA_HORA = 60 * 60_000;
    const recarregar = () => location.reload();
    let espera = setTimeout(recarregar, Number(presenca.dataset.msAteInatividade));
    let ultimoAviso = -Infinity;
    let avisando = false;

    const avisar = async () => {
      if (avisando || performance.now() - ultimoAviso < 60_000) return;
      avisando = true;
      ultimoAviso = performance.now();
      try {
        const resposta = await fetch('/timer/interacao', { method: 'POST' });
        const timer = await resposta.json();
        if (!timer.ligado || timer.pausado) return recarregar();
        clearTimeout(espera);
        espera = setTimeout(recarregar, UMA_HORA);
      } catch {
        // Sem rede: a próxima interação tenta de novo.
      } finally {
        avisando = false;
      }
    };

    for (const evento of ['pointerdown', 'keydown', 'wheel', 'touchstart']) {
      addEventListener(evento, avisar, { passive: true });
    }
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) avisar();
    });
  }
</script>

