---
import Base from '../layouts/Base.astro';
import { podeEntrar } from '../lib/permissao';

if (Astro.locals.usuario) return Astro.redirect('/');

let enviadoPara: string | null = null;
let erro =
  Astro.url.searchParams.get('erro') === 'link'
    ? 'Esse link expirou ou já foi usado. Peça outro.'
    : null;

if (Astro.request.method === 'POST') {
  const email = String((await Astro.request.formData()).get('email') ?? '').trim();
  // Fora da lista, nenhum link sai, mas a resposta é a mesma: a página não
  // revela quem pode entrar.
  const { error } = podeEntrar(email)
    ? await Astro.locals.supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: new URL('/auth/callback', Astro.url).toString() },
      })
    : { error: null };
  if (error) erro = 'Não deu para enviar o link. Confira o e-mail e tente de novo.';
  else enviadoPara = email;
}
---

<Base titulo="Entrar">
  <main>
    <h1>Aibou</h1>
    {
      enviadoPara ? (
        <p role="status">
          Mandamos um link para <strong>{enviadoPara}</strong>. Abra neste aparelho para entrar.
        </p>
      ) : (
        <form method="post">
          <label for="email">Seu e-mail</label>
          <input id="email" name="email" type="email" autocomplete="email" required autofocus />
          {erro && <p class="erro" role="alert">{erro}</p>}
          <button type="submit">Receber link de acesso</button>
        </form>
      )
    }
  </main>
</Base>

<script>
  // Enviando: o botão trava até a página responder, para não sair um segundo link.
  const form = document.querySelector<HTMLFormElement>('main form');
  form?.addEventListener('submit', () => {
    form.setAttribute('aria-busy', 'true');
    setTimeout(() => form.querySelector('button')?.setAttribute('disabled', ''));
  });
</script>

<style>
  main {
    display: grid;
    gap: 2rem;
    align-content: center;
    width: min(100% - 2 * var(--espaco), 26rem);
    min-height: 100dvh;
    margin-inline: auto;
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 3.5rem);
  }

  form {
    display: grid;
    gap: 0.75rem;
  }

  label {
    color: var(--texto-suave);
  }
</style>
